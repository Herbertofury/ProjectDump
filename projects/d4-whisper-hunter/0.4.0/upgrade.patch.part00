diff --git a/.github/workflows/build-windows.yml b/.github/workflows/build-windows.yml
index 6674799..7d3db5a 100644
--- a/.github/workflows/build-windows.yml
+++ b/.github/workflows/build-windows.yml
@@ -21,12 +21,25 @@ jobs:
           cache: pip
       - name: Install current production dependencies
         run: python -m pip install -r requirements-build.txt
+      - name: Fetch and verify permitted upstream map asset
+        run: python scripts/fetch_upstream_map.py
       - name: Compile and regress
         run: |
           python -m compileall -q whisper_hunter d4_whisper_hunter.py tests
           python -m pytest -q
       - name: Build one-file Windows executable
-        run: pyinstaller --noconfirm --clean --onefile --windowed --name D4WhisperHunter --collect-all cv2 d4_whisper_hunter.py
+        run: pyinstaller --noconfirm --clean --onefile --windowed --name D4WhisperHunter --collect-all cv2 --add-data "assets/map_5_small.jpg;assets" d4_whisper_hunter.py
+      - name: Prove packaged EXE resolves bundled map offline-first
+        shell: pwsh
+        run: |
+          Remove-Item Env:D4WH_MAP_PATH -ErrorAction SilentlyContinue
+          $cache = Join-Path $env:APPDATA 'D4WhisperHunter\assets\map_5_small.jpg'
+          Remove-Item $cache -Force -ErrorAction SilentlyContinue
+          & '.\dist\D4WhisperHunter.exe' --asset-check | Tee-Object -FilePath '_asset-check.json'
+          if ($LASTEXITCODE -ne 0) { throw "Asset check returned $LASTEXITCODE" }
+          $result = Get-Content '_asset-check.json' -Raw | ConvertFrom-Json
+          if (-not [bool]$result.verified) { throw 'Bundled map failed integrity verification' }
+          if ($result.source -ne 'bundled') { throw "Expected bundled map source; got $($result.source)" }
       - name: Create deterministic packaged-runtime fixture
         run: python tests/make_ci_fixture.py --out _ci
       - name: Smoke-test the packaged executable headlessly
